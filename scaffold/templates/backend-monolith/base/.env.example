# 复制为同目录的 .env，用于本机开发与集成测试的覆盖项（.env 已被 .gitignore 忽略）。
#
# 全部可选：不建 .env 时用 application-db.yml 与 scripts/dev-it.sh 的内置默认值。
# ⚠️ 这里只放本机开发/测试的值；生产凭据由部署方经环境变量注入，不要提交真实口令。
#?if db == "postgres" or db == "mysql"
# 集成测试容器里的应用账号
#DB_USER={{db_user}}
#DB_PASSWORD={{db_password}}
#?endif
#?if db == "mysql"
# 仅 mysql：容器内 root 口令（应用账号是上面的普通账号，root 不对外）
#DB_ROOT_PASSWORD=root
#?endif
# 集成测试容器的宿主端口：与本机已有服务冲突时取消注释并修改
#DB_HOST_PORT={{db_port}}
#?if cache == "redis"
#REDIS_HOST_PORT=6379
#?endif
